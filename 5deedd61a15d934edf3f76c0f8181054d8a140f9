      "author": {
        "id": 1894735
      },
      "writtenOn": "2025-02-05T15:30:39Z",
      "side": 1,
      "message": "Why don\u0027t we do this sooner? I understand we should have built a graph but maybe we could do it before running the optimizations? Maybe on lines 963?",
      "range": {
        "startLine": 995,
        "startChar": 7,
        "endLine": 995,
        "endChar": 49
      },
      "revId": "5deedd61a15d934edf3f76c0f8181054d8a140f9",
