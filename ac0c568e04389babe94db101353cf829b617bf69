      "writtenOn": "2025-03-19T13:53:07Z",
      "side": 1,
      "message": "In this case it\u0027s about discovering any bug closer to its source, but it\u0027s less important.",
      "parentUuid": "71896841_3fc366cd",
      "range": {
        "startLine": 66,
        "startChar": 56,
