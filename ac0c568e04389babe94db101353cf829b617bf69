        "id": 1373864
      },
      "writtenOn": "2025-03-17T22:22:34Z",
      "side": 1,
      "message": "Consider doing some vetting of the value here, so that later code doesn\u0027t have to worry about garbage.",
      "range": {
        "startLine": 55,
        "startChar": 27,
        "endLine": 55,
        "endChar": 35
      },
