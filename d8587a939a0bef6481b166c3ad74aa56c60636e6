      },
      "writtenOn": "2025-03-06T12:16:57Z",
      "side": 1,
      "message": "Don\u0027t we need to call the artQuickGenericJniEndTrampoline after the native call?",
      "range": {
        "startLine": 198,
        "startChar": 3,
        "endLine": 199,
        "endChar": 14
      },
      "revId": "d8587a939a0bef6481b166c3ad74aa56c60636e6",
