        "id": 1989777
      },
      "writtenOn": "2025-03-13T22:24:32Z",
      "side": 1,
      "message": "This is needed because we previously calculated the delta (in r12) between the JNI stack args and the reserved area ptr with the registers still on the stack. Therefore, once we pop these registers off the stack this delta will be incorrect and need re-adjustment.\n\nI have now changed this to no longer pop the registers off the stack and instead just load the values. This makes the readjustment unnecessary and hopefully makes it clearer where all of this is loaded from.",
      "parentUuid": "149c2ebc_b5e363ee",
      "range": {
        "startLine": 195,
        "startChar": 4,
        "endLine": 196,
        "endChar": 27
      },
      "revId": "d8587a939a0bef6481b166c3ad74aa56c60636e6",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
    {
      "unresolved": true,
      "key": {
        "uuid": "dd475add_cd2ffef6",
