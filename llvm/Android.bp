package {
    default_applicable_licenses: ["llvm_license_art"],
}

license {
    name: "llvm_license_art",
    visibility: [":__subpackages__"],
    license_kinds: [
        "SPDX-license-identifier-Apache-2.0",
        "SPDX-license-identifier-MIT",
    ],
    license_text: [
        "llvm/LICENSE.TXT",
    ],
}

cc_prebuilt_library_static {
    name: "libLLVM_ART",
    visibility: ["//art:__subpackages__"],
    host_supported: true,
    target: {
        linux_glibc_x86: {
            srcs: ["linux_glibc_x86/lib/libLLVM.a"],
            export_include_dirs: ["linux_glibc_x86/include"],
        },
        linux_glibc_x86_64: {
            srcs: ["linux_glibc_x86_64/lib/libLLVM.a"],
            export_include_dirs: ["linux_glibc_x86_64/include"],
        },
        android_arm64: {
            srcs: ["android_arm64/lib/libLLVM.a"],
            export_include_dirs: ["android_arm64/include"],
        },
    },

    min_sdk_version: "apex_inherit",
    apex_available: [
        "com.android.art",
        "com.android.art.debug",
    ],
}
