+//===----------------------------------------------------------------------===//
+//                       ARTCatchSwitchInst Implementation
+//===----------------------------------------------------------------------===//
+
+ARTCatchSwitchInst::ARTCatchSwitchInst(const ARTCatchSwitchInst &CSI)
+    : Instruction(CSI.getType(), Instruction::ARTCatchSwitch, nullptr,
+                  CSI.getNumOperands()) {
+  init(CSI.getNumOperands());
+  setNumHungOffUseOperands(ReservedSpace);
+  Use *OL = getOperandList();
+  const Use *InOL = CSI.getOperandList();
+  for (unsigned I = 1, E = ReservedSpace; I != E; ++I)
+    OL[I] = InOL[I];
+}
+
+ARTCatchSwitchInst::ARTCatchSwitchInst(LLVMContext &Context,
+                                       unsigned NumHandlers,
+                                       Instruction *InsertBefore)
+    : Instruction(Type::getVoidTy(Context), Instruction::ARTCatchSwitch,
+                  nullptr, 0, InsertBefore) {
+  init(NumHandlers);
+}
+
+ARTCatchSwitchInst::ARTCatchSwitchInst(LLVMContext &Context,
+                                       unsigned NumHandlers,
+                                       BasicBlock *InsertAtEnd)
+    : Instruction(Type::getVoidTy(Context), Instruction::ARTCatchSwitch,
+                  nullptr, 0, InsertAtEnd) {
+  init(NumHandlers);
+}
+
+void ARTCatchSwitchInst::init(unsigned NumReserved) {
+  ReservedSpace = NumReserved;
+  setNumHungOffUseOperands(0);
+  allocHungoffUses(ReservedSpace);
+}
+
+void ARTCatchSwitchInst::growOperands(unsigned Size) {
+  unsigned NumOperands = getNumOperands();
+  if (ReservedSpace >= NumOperands + Size)
+    return;
+  ReservedSpace = (std::max(NumOperands, 1U) + Size / 2) * 2;
+  growHungoffUses(ReservedSpace);
+}
+
+void ARTCatchSwitchInst::addHandler(BasicBlock *Handler) {
+  unsigned OpNo = getNumOperands();
+  growOperands(1);
+  assert(OpNo < ReservedSpace && "Growing didn't work!");
+  setNumHungOffUseOperands(OpNo + 1);
+  getOperandList()[OpNo] = Handler;
+}
