+ModRefInfo AAResults::getModRefInfo(const ARTCatchPadInst *CatchPad,
+                                    const MemoryLocation &Loc,
+                                    AAQueryInfo &AAQI) {
+  if (Loc.Ptr) {
+    // If the pointer is a pointer to invariant memory,
+    // then it could not have been modified by this artcatchpad.
+    return getModRefInfoMask(Loc, AAQI);
