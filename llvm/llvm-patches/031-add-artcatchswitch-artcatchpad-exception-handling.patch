+//===----------------------------------------------------------------------===//
+//                         ARTCatchSwitchInst Class
+//===----------------------------------------------------------------------===//
+class ARTCatchSwitchInst : public Instruction {
+  /// The number of operands actually allocated.  NumOperands is
+  /// the number actually in use.
+  unsigned ReservedSpace;
+
+  // Operand[n] = BasicBlock to go to on match
+  ARTCatchSwitchInst(const ARTCatchSwitchInst &CSI);
+
+  /// Create a new switch instruction, specifying a default destination.  The
+  /// number of additional handlers can be specified here to make memory
+  /// allocation more efficient. This constructor can also autoinsert before
+  /// another instruction.
+  ARTCatchSwitchInst(LLVMContext &Context, unsigned NumHandlers,
+                     Instruction *InsertBefore);
+
+  /// Create a new switch instruction, specifying a default destination.  The
+  /// number of additional handlers can be specified here to make memory
+  /// allocation more efficient. This constructor also autoinserts at the end of
+  /// the specified BasicBlock.
+  ARTCatchSwitchInst(LLVMContext &Context, unsigned NumHandlers,
+                     BasicBlock *InsertAtEnd);
+
+  // allocate space for exactly zero operands
+  void *operator new(size_t Size) { return User::operator new(Size); }
+
+  void init(unsigned NumReserved);
+  void growOperands(unsigned Size);
+
+protected:
+  // Note: Instruction needs to be a friend here to call cloneImpl.
+  friend class Instruction;
+
+  ARTCatchSwitchInst *cloneImpl() const;
+
+public:
+  void operator delete(void *Ptr) { return User::operator delete(Ptr); }
+
+  static ARTCatchSwitchInst *Create(LLVMContext &Context, unsigned NumHandlers,
+                                    Instruction *InsertBefore = nullptr) {
+    return new ARTCatchSwitchInst(Context, NumHandlers, InsertBefore);
+  }
+
+  static ARTCatchSwitchInst *Create(LLVMContext &Context, unsigned NumHandlers,
+                                    BasicBlock *InsertAtEnd) {
+    return new ARTCatchSwitchInst(Context, NumHandlers, InsertAtEnd);
+  }
+
+  /// Provide fast operand accessors
+  DECLARE_TRANSPARENT_OPERAND_ACCESSORS(Value);
+
+  /// return the number of 'handlers' in this artcatchswitch instruction
+  unsigned getNumHandlers() const { return getNumOperands(); }
+
+  /// Add an entry to the switch instruction...
+  /// Note:
+  /// This action invalidates handler_end(). Old handler_end() iterator will
+  /// point to the added handler.
+  void addHandler(BasicBlock *Handler);
+
+  unsigned getNumSuccessors() const { return getNumOperands(); }
+  BasicBlock *getSuccessor(unsigned Idx) const {
+    assert(Idx < getNumSuccessors() &&
+           "Successor # out of range for catchswitch!");
+    return cast<BasicBlock>(getOperand(Idx));
+  }
+  void setSuccessor(unsigned Idx, BasicBlock *NewSucc) {
+    assert(Idx < getNumSuccessors() &&
+           "Successor # out of range for catchswitch!");
+    setOperand(Idx, NewSucc);
+  }
+
+  // Methods for support type inquiry through isa, cast, and dyn_cast:
+  static bool classof(const Instruction *I) {
+    return I->getOpcode() == Instruction::ARTCatchSwitch;
+  }
+  static bool classof(const Value *V) {
+    return isa<Instruction>(V) && classof(cast<Instruction>(V));
+  }
+};
+
+template <>
+struct OperandTraits<ARTCatchSwitchInst> : public HungoffOperandTraits<0> {};
+
+DEFINE_TRANSPARENT_OPERAND_ACCESSORS(ARTCatchSwitchInst, Value)
+
+//===----------------------------------------------------------------------===//
+//                               ARTCatchPadInst Class
+//===----------------------------------------------------------------------===//
+class ARTCatchPadInst : public Instruction {
+private:
+  ARTCatchPadInst(LLVMContext &Context, Instruction *InsertBefore = nullptr)
+      : Instruction(Type::getVoidTy(Context), Instruction::ARTCatchPad, nullptr,
+                    0, InsertBefore) {}
+
+  ARTCatchPadInst(LLVMContext &Context, BasicBlock *InsertAtEnd)
+      : Instruction(Type::getVoidTy(Context), Instruction::ARTCatchPad, nullptr,
+                    0, InsertAtEnd) {}
+
+  // allocate space for exactly zero operands
+  void *operator new(size_t S) { return User::operator new(S, 0); }
+
+protected:
+  // Note: Instruction needs to be a friend here to call cloneImpl.
+  friend class Instruction;
+
+  ARTCatchPadInst *cloneImpl() const;
+
+public:
+  static ARTCatchPadInst *Create(LLVMContext &Context,
+                                 Instruction *InsertBefore = nullptr) {
+    return new ARTCatchPadInst(Context, InsertBefore);
+  }
+
+  static ARTCatchPadInst *Create(LLVMContext &Context,
+                                 BasicBlock *InsertAtEnd) {
+    return new ARTCatchPadInst(Context, InsertAtEnd);
+  }
+
+  /// Methods for support type inquiry through isa, cast, and dyn_cast:
+  static bool classof(const Instruction *I) {
+    return I->getOpcode() == Instruction::ARTCatchPad;
+  }
+  static bool classof(const Value *V) {
+    return isa<Instruction>(V) && classof(cast<Instruction>(V));
+  }
+};
+
