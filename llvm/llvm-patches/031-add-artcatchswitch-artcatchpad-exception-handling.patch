+/// parseARTCatchSwitch
+///   ::= 'artcatchswitch' '[' LabelList ']'
+bool LLParser::parseARTCatchSwitch(Instruction *&Inst, PerFunctionState &PFS) {
+  if (parseToken(lltok::lsquare, "expected '[' with artcatchswitch labels"))
+    return true;
+
+  SmallVector<BasicBlock *, 32> Table;
+  do {
+    BasicBlock *DestBB;
+    if (parseTypeAndBasicBlock(DestBB, PFS))
+      return true;
+    Table.push_back(DestBB);
+  } while (EatIfPresent(lltok::comma));
+
+  if (parseToken(lltok::rsquare, "expected ']' after artcatchswitch labels"))
+    return true;
+
+  auto *CatchSwitch = ARTCatchSwitchInst::Create(M->getContext(), Table.size());
+  for (BasicBlock *DestBB : Table)
+    CatchSwitch->addHandler(DestBB);
+  Inst = CatchSwitch;
+  return false;
+}
+
+/// parseARTCatchPad
+///   ::= 'artcatchpad'
+bool LLParser::parseARTCatchPad(Instruction *&Inst, PerFunctionState &PFS) {
+  Inst = ARTCatchPadInst::Create(M->getContext());
+  return false;
+}
