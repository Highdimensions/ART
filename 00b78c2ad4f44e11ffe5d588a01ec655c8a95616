      "writtenOn": "2025-03-19T21:59:08Z",
      "side": 1,
      "message": "What if `sdm_path.isInDalvikCache` is set? Handle or add assertion?",
      "revId": "00b78c2ad4f44e11ffe5d588a01ec655c8a95616",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
